        }
      ]
    },
    {
      "id": "review-does-not-authorize-fixes",
      "canonical": {
        "path": "references/review.md",
        "includes": "Review is read-only by default."
      },
      "duplicates": [
        {
          "path": "references/architect/review.md",
          "includes": "Review never authorizes edits by itself."
        }
      ]
    }
  ]
}
